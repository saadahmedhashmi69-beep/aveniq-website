# Copy to .env.local for development. Never commit real values —
# .env* is already gitignored.

# Contact form email delivery (see app/api/contact/route.ts).
# Sign up at https://resend.com, verify a sending domain, and create an
# API key. Until both variables are set, the contact form correctly
# reports itself as not yet connected rather than faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# The production site URL, used for canonical links, sitemap.xml, and
# Open Graph metadata (see app/layout.tsx). Falls back to
# http://localhost:3000 if unset. Set this to the real domain once
# confirmed — see docs/phase-1-architecture.md, section Q.
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection string used by Prisma (see prisma/schema.prisma,
# prisma.config.ts, lib/prisma.ts). Required for the admin CMS, inquiry
# storage, and portfolio content. Example format:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
